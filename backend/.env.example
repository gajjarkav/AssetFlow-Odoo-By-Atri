# ─── AssetFlow — Environment Configuration ────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Async SQLAlchemy URL for PostgreSQL (Neon, Supabase, local, etc.)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/assetflow

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Keep SECRET_KEY stable across restarts — changing it invalidates all active tokens.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=AssetFlow
DEBUG=False

# ── CORS (Frontend Origins) ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your Vite dev server and any deployed frontend URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── SMTP / Email (OTP) ────────────────────────────────────────────────────────
# Set SMTP_ENABLED=false for local/demo (disables OTP email sending).
# Only set true if you have a valid Gmail App Password for OTP verification.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
